# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# 문서 (기획/계획 문서는 레포에 올리지 않음)
*.md
!README.md

# 에이전트 도구 설정 — 개인 환경이라 사람마다 다르다
.claude/

# 작업 중 잘라둔 중간 산출물. 와이어프레임은 Figma 가 원본이고 여기 PDF 렌더는 사본이라
# 금방 낡는다 (v24 스냅샷은 이미 Figma 최신본과 문구가 다르다).
/tmp/

# GIS 중간 산출물 — 표준노드링크 전국 데이터(257MB zip)에서 잘라낸 것.
# scripts/build-route-data.mjs 주석의 ogr2ogr 명령으로 다시 만든다.
# 최종 산출물 data/route-data.json 은 작아서 커밋한다.
/data/*.geojson

# 카카오 길찾기 원본 응답 — 스크립트가 다시 받는다 (없으면 받고, 있으면 안 받는다).
# scripts/left-turn-worklist.mjs 가 구간마다 route-<이름>-<우선순위>.json 으로 쌓는데,
# 판독 대상을 넓힐수록 는다 (지금 68개 3.5MB). 여기서 뽑아낸 결과물만 커밋한다:
# data/route-data.json(폴백 경로) · data/unprotected-left.json(비보호 판독표).
/data/route-*.json
!/data/route-data.json

# 구글 클라우드 TTS 서비스 계정 키 — 절대 커밋 금지
gcp-tts.json

# 비보호 판독 중간 산출물 — 판독표(data/unprotected-left.json)만 최종 결과물이다.
# turninfo.csv 는 표준노드링크 배포본에서 뽑는다 (build-left-turn-candidates.mjs 주석 참고).
# judge-input*.json 은 left-turn-candidates.json 을 수집 스크립트 입력 형식으로 옮긴 것뿐이다.
/data/turninfo.csv
/data/judge-input*.json

# 파이썬 스크립트 실행 부산물
__pycache__/

# 기획용 참고 사진 — 앱이 안 쓴다. public/ 밖이라 배포에도 안 들어간다.
/예시-사진/
