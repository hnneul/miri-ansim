# OpenAI API key for AI-generated route explanation text.
# Create this in the OpenAI Platform project that owns the shared team credits.
# If missing or failing, the app falls back to rule-based sentences (lib/briefing.ts).
OPENAI_API_KEY=

# Kakao JavaScript map key. This is exposed to the browser by design.
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Kakao REST API key for geocoding, route search, and live traffic.
KAKAO_REST_API_KEY=

# 배포용 Google Cloud TTS 서비스 계정 — gcp-tts.json 내용을 한 줄 JSON 으로 넣는다
# (jq -c . gcp-tts.json). 로컬은 이 값이 없으면 gcp-tts.json 파일을 직접 읽는다.
# 없으면 음성이 Edge(SunHi)로 조용히 떨어진다 — 에러가 아니라 목소리만 바뀐다.
GCP_TTS_KEY=

# /api/tts 대본 서명용 비밀키. 아무 긴 무작위 문자열이면 된다.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TTS_SIGN_SECRET=

# 제주 ITS 실시간 소통정보 (jejuits.go.kr/open_api). 없으면 소통 화면이 조용히 빈다.
JEJU_ITS_API_KEY=

# 한국관광공사 TourAPI 서비스키. 관광지 정보 조회에 쓴다.
TOUR_API_KEY=

# 시연용 현위치 고정 "위도,경도". 값이 있으면 GPS 대신 이 좌표를 쓴다 (app/DemoLocation.tsx).
# 서울에서 시연할 때 제주 기준 화면들이 비지 않게 하려는 것 — 평소에는 비워 둔다.
# 제주국제공항 = 33.507,126.493
NEXT_PUBLIC_DEMO_HERE=
